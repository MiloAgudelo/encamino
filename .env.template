# URL base del backend de Karamba (Django). En desarrollo es la copia local de
# karamba-backend; desde el teléfono, usa la IP de tu PC en la red (no localhost)
# o la URL de un túnel. No es un secreto: las variables EXPO_PUBLIC_ quedan
# dentro de la app.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Llave de Google Maps para Android. Solo se necesita al compilar la app propia
# (APK); en Expo Go no hace falta. Restríngela en Google Cloud al paquete
# com.karambabymarce.encamino y a la huella SHA-1 del certificado.
GOOGLE_MAPS_ANDROID_API_KEY=
